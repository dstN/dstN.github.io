<section id="contact" class="section">
  <div class="w-base">
    <div class="contact-layout">
      <div class="contact-aside">
        <h2>Get in Touch</h2>
        <p style="color: var(--ink-muted); font-size: 0.9375rem;">
          Have a project in mind or just want to chat? I'd love to hear from you.
        </p>

        <div class="contact-info">
          <p>Hamburg, Germany</p>
          <p>
            <a href="#" id="contact-email-link" data-u="dustin.tramm" data-d="yinside.de">Loading email...</a>
          </p>
          <p>Usually responds within 24 hours</p>
        </div>

        <div class="contact-social">
          <a href="https://github.com/dstN" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/dustin-aaron-tramm/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <form class="contact-form" id="contact-form" method="POST">
        <div class="form-field">
          <label for="contact-name">Name</label>
          <input type="text" id="contact-name" name="name" required minlength="2" autocomplete="name" />
        </div>

        <div class="form-field">
          <label for="contact-email">Email</label>
          <input type="email" id="contact-email" name="email" required autocomplete="email" />
        </div>

        <div class="form-field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" required minlength="10" rows="5"></textarea>
        </div>

        <!-- Honeypot: people never see or fill this field; when it is filled, nothing is sent. -->
        <div class="form-hp" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div id="form-status" class="form-status" role="status"></div>

        <button type="submit" class="btn btn-primary" id="contact-submit" style="width:100%;">
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  // Email obfuscation
  const emailLink = document.getElementById("contact-email-link");
  const addr = emailLink ? emailLink.dataset.u + "@" + emailLink.dataset.d : "";
  if (emailLink) {
    emailLink.setAttribute("href", "mailto:" + addr);
    emailLink.textContent = addr;
  }

  // The form goes as JSON to Dustin's own mail relay (repo dstN/kontakt-relay), which allows this origin. The browser
  // validates the fields on submit. On any failure the text stays in the fields and the status line names the mailbox.
  const RELAY = "https://contact.yinside.de/phpmailer.php";
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLElement;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement;
  const emailField = document.getElementById("contact-email") as HTMLInputElement;
  const trap = document.getElementById("contact-website") as HTMLInputElement;
  // while a message is on its way the button stays focusable (aria-disabled, not disabled), so focus is not lost
  let sending = false;

  function show(kind: "success" | "error" | "", text: string, mailbox = false) {
    statusEl.className = "form-status" + (kind ? " " + kind : "");
    statusEl.textContent = text;
    if (mailbox && addr) {
      const a = document.createElement("a");
      a.href = "mailto:" + addr;
      a.textContent = addr;
      statusEl.append(" ", a, ".");
    }
  }

  const failed = () => show("error", "Your message could not be sent. Please email me directly at", true);

  emailField.addEventListener("input", () => emailField.removeAttribute("aria-invalid"));

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (sending) return;
    // a bot filled the trap: nothing leaves the page, a person who somehow did gets the mailbox
    if (trap.value) return failed();

    const data = new FormData(form);
    const value = (key: string) => String(data.get(key) ?? "").trim();
    sending = true;
    submitBtn.setAttribute("aria-disabled", "true");
    show("", "Sending your message...");

    try {
      const res = await fetch(RELAY, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: value("name"), email: value("email"), message: value("message") }),
        signal: AbortSignal.timeout(20_000),
      });
      const body: unknown = await res.json().catch(() => null);
      const isObj = typeof body === "object" && body !== null;

      if (res.ok && isObj && "success" in body && body.success === true) {
        form.reset();
        show("success", "Message sent! I'll get back to you soon.");
      } else if (res.status === 400) {
        const error = isObj && "error" in body && typeof body.error === "string" ? body.error : "";
        if (/email/i.test(error)) {
          emailField.setAttribute("aria-invalid", "true");
          emailField.focus();
          show("error", "Please check your email address.");
        } else {
          show("error", "Please fill in your name, email and message.");
        }
      } else {
        failed();
      }
    } catch {
      failed();
    } finally {
      sending = false;
      submitBtn.removeAttribute("aria-disabled");
    }
  });
</script>
